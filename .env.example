# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# On Vercel, add the same keys under: Project -> Settings -> Environment Variables.
# NEVER commit real values. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# The public production URL of the site, without a trailing slash.
# Used for canonical URLs, hreflang tags, the sitemap and social preview images.
# Vercel sets this automatically on preview deploys if you leave it empty,
# but you SHOULD set it explicitly for production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Contact form e-mail delivery (Resend)
#
# All three must be set together. With any of them missing the form still
# validates, still filters spam and still reports accessibly - it just answers
# "sending through the form is not active yet" in the visitor's own language
# and points them at the e-mail address instead. Nothing crashes.
#
# SETUP, IN ORDER
#
#   1. Create an account at https://resend.com
#
#   2. Domains -> Add Domain -> enter your sending domain (e.g. andrejweb.be).
#      Resend shows DNS records (DKIM, SPF, and usually a DMARC suggestion).
#      Add them at whoever manages the domain's DNS, then press Verify.
#      Wait for the domain to read "Verified" - until it does, sending fails.
#
#   3. API Keys -> Create API Key.
#      Permission: "Sending access" is enough. Domain: the one from step 2.
#      Copy the key now - Resend shows it exactly once.
#
#   4. Put the three values below into Vercel:
#      Project -> Settings -> Environment Variables -> Add New,
#      ticking Production (and Preview, if you want the form live there too).
#
#   5. Redeploy. Environment variables are read at runtime, but an existing
#      deployment keeps the values it was built with, so a redeploy is needed.
#
# The key is a server-side secret. It must never be prefixed NEXT_PUBLIC_,
# never appear in a component, and never be committed.
# ---------------------------------------------------------------------------

# API key from the Resend dashboard. Starts with `re_`.
RESEND_API_KEY=

# The "from" address. The domain part MUST be a domain verified in Resend -
# it cannot be a gmail.com/outlook.com address, and it is not where replies
# go (that is the visitor's own address, set as reply-to automatically).
# Plain address, or "Name <address>":
#   website@andrejweb.be
#   Andrej Juriga Website <website@andrejweb.be>
CONTACT_FROM_EMAIL=

# Where form submissions are delivered - your own inbox. Any address,
# no verification needed.
CONTACT_TO_EMAIL=
