# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# On Vercel, add the same keys under: Project -> Settings -> Environment Variables.
# NEVER commit real values. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# The public production URL of the site, without a trailing slash.
# Used for canonical URLs, hreflang tags, the sitemap and social preview images.
# Vercel sets this automatically on preview deploys if you leave it empty,
# but you SHOULD set it explicitly for production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Contact form e-mail delivery (OPTIONAL until you are ready to receive mail)
#
# The contact form works without these: it validates input and returns a clear,
# translated error saying delivery is not configured yet. Nothing crashes.
#
# To switch delivery on, create a free account at resend.com, verify your
# sending domain, then set all three values below.
# ---------------------------------------------------------------------------

# API key from the Resend dashboard.
RESEND_API_KEY=

# The "from" address. Must be on a domain you have verified in Resend.
# Example: website@jurigadigital.be
CONTACT_FROM_EMAIL=

# Where form submissions should be delivered - your own inbox.
CONTACT_TO_EMAIL=
